erDiagram
    USER ||--o| CUSTOMER : "has login"
    USER ||--o{ TRANSACTION : "operates"
    ACCOUNT_TYPE ||--o{ ACCOUNT : "defines"
    CUSTOMER ||--o{ ACCOUNT : "owns"
    ACCOUNT ||--o{ TRANSACTION : "records"
    INTEREST_RUN ||--o{ TRANSACTION : "credits"
    USER ||--o{ INTEREST_RUN : "runs"
    USER ||--o{ AUDIT_LOG : "creates"

    USER {
        INTEGER user_id PK
        TEXT username
        TEXT role
        TEXT status
        INTEGER failed_attempts
        TEXT password_hash
        INTEGER must_change_password
        TEXT created_at
        TEXT updated_at
    }

    CUSTOMER {
        INTEGER customer_id PK
        INTEGER user_id FK
        TEXT customer_code
        TEXT full_name
        TEXT email
        TEXT phone
        TEXT identification_reference
        TEXT address
        TEXT date_of_birth
        TEXT status
        TEXT created_at
        TEXT updated_at
    }

    ACCOUNT_TYPE {
        INTEGER type_id PK
        TEXT type_name
        INTEGER min_balance
        INTEGER interest_rate
        INTEGER daily_withdrawal_limit
        TEXT created_at
    }

    ACCOUNT {
        INTEGER account_id PK
        TEXT account_number
        INTEGER customer_id FK
        INTEGER type_id FK
        TEXT status
        INTEGER balance
        TEXT opened_at
        TEXT created_at
        TEXT updated_at
    }

    TRANSACTION {
        INTEGER transaction_id PK
        INTEGER account_id FK
        INTEGER operator_id FK
        TEXT type
        INTEGER amount
        INTEGER resulting_balance
        TEXT created_at
        TEXT transfer_ref
        INTEGER interest_run_id FK
    }

    AUDIT_LOG {
        INTEGER log_id PK
        INTEGER user_id FK
        TEXT action
        TEXT entity
        INTEGER entity_id
        TEXT details
        TEXT timestamp
    }

    INTEREST_RUN {
        INTEGER run_id PK
        TEXT period
        INTEGER run_by FK
        TEXT run_at
        INTEGER accounts_credited
        INTEGER total_interest
    }